# true or false (case-insensitive)
#tc_frame.encrypted: FALSE

# No description
# true or false (case-insensitive)
tc_frame.segment_header: TRUE

# Cyclic Redundancy Check
# true or false (case-insensitive)
tc_frame.crc: TRUE

# Whether we check TC Frame CRC or not
# true or false (case-insensitive)
tc_frame.check_crc: TRUE

# SDLS configuration, overwrites preferences
# One of: Preferences, Default TC, No SDLS
# (case-insensitive).
tc_frame.sdls_config: No SDLS

# Whether we check Space Packet PEC or not
# true or false (case-insensitive)
tc_pus.check_pec: TRUE

# Whether the data is encrypted or not, do we continue dissecting or not
# true or false (case-insensitive)
#tm_frame.encrypted: FALSE

# Cyclic Redundancy Check
# true or false (case-insensitive)
tm_frame.crc: TRUE

