                        <node-port>2</node-port>
                    </connection>
                </connections>
                <data-provider>               
                    <type>GENERICRWSIMDATA42SOCKETPROVIDER</type>
                    <hostname>192.168.100.42</hostname>
                    <port>4277</port>
                    <command-port>4278</command-port>
                    <max-connection-attempts>200</max-connection-attempts>
                    <retry-wait-seconds>3</retry-wait-seconds>
