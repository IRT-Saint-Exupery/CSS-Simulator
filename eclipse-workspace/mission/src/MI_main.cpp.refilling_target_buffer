bool fileExist(const char* filename) {
	FILE *file = fopen(filename, "r");
	if (file == NULL) {
	     //perror("Failed to open file");
	     return false; // error code
	}
	else {
		fclose(file);
		return true;
	}
}


void createIsBusyFile(int N) {
    std::ofstream file("/tmp/isbusy.txt");
    for (int i = 0; i < N; ++i)
        file << 0 << '\n';
}

void setBusyState(const char* state, int pos, int N) {
    int values[N];
    int count = 0;
    FILE* f = fopen("/tmp/isbusy.txt", "r");
    if (!f) return;

    while (count < N && fscanf(f, "%d", &values[count]) == 1)
        count++;
    fclose(f);

    if (pos < 1 || pos > count)
        return;

    values[pos - 1] = (strcmp(state, "busy") == 0) ? 1 : 0;
    f = fopen("/tmp/isbusy.txt", "w");
    if (!f) return;

    for (int i = 0; i < count; i++)
        fprintf(f, "%d\n", values[i]);

    fclose(f);
}

