using namespace std;

const double WGS84_A = 6378137.0;
const double WGS84_E2 = 6.6943799901377997e-3;
const double DIST_MIN = 1'340'000.0; // m
const double altitudeSat = 1'300'000; //m

enum TargetStatus { Missing, InProgress, Done };
enum SatStatus { SatFree, SatBusy };

struct Target {
    double lat, lon;
    string name;
    double x, y, z;
    TargetStatus status = Missing;
    int satellite = -1;
    time_t dateCommande = 0;
};

struct Satellite {
    double x, y, z; // nadir pos
    SatStatus status = SatFree;
};

vector<Target> readTargets(const string& filename) {
    vector<Target> targets;
    ifstream file(filename);
    if (!file) {
        cerr << "Could not open file: " << filename << endl;
        return targets;
    }
    string line;
    while (getline(file, line)) {
        istringstream iss(line);
        Target t;
        if (!(iss >> t.lat >> t.lon >> t.name)) {
            cerr << "Skipping malformed line: " << line << endl;
            continue; // Skip lines that don't parse
        }
        targets.push_back(t);
    }
    return targets;
}


int get_NSat_value_from_script(const char *filename) {
    FILE *file = fopen(filename, "r");
    if (file == NULL) {
        perror("Failed to open script file");
        return -1; // error code
    }

    char line[256];
    int value = -1; // default if not found

    while (fgets(line, sizeof(line), file)) {
        // Look for a line that starts with "AA="
        if (strncmp(line, "NBSAT=", 6) == 0) {
            // Extract the numeric value after "AA="
            char *ptr = line + 6; // move past "AA="
            value = atoi(ptr);
            break;
        }
    }

    fclose(file);
    return value;
}


void geoToECEF(Target& t) {
    double latRad = t.lat * M_PI / 180.0;
    double lonRad = t.lon * M_PI / 180.0;
    double N = WGS84_A / sqrt(1 - WGS84_E2 * sin(latRad) * sin(latRad));
    double alt = 0.0;

    t.x = (N + alt) * cos(latRad) * cos(lonRad);
    t.y = (N + alt) * cos(latRad) * sin(lonRad);
    t.z = (N * (1 - WGS84_E2) + alt) * sin(latRad);
}

double distance(const Target& t, const Satellite& s) {
    return sqrt(pow(t.x - s.x, 2) + pow(t.y - s.y, 2) + pow(t.z - s.z, 2));
}

void readSatellitePositions(vector<Satellite>& sats) {
    for (int i = 0; i < 7; ++i) {
        string filename = "/tmp/pos" + to_string(i + 1) + ".txt";
        ifstream file(filename);
        if (file) {
            file >> sats[i].x >> sats[i].y >> sats[i].z; // true pos sat
            double fact = WGS84_A / (WGS84_A  + altitudeSat);
            sats[i].x *= fact;
            sats[i].y *= fact;
            sats[i].z *= fact;
        }
    }
}

